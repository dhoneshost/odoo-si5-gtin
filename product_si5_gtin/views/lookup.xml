<odoo>
    <record id="template_form_si5" model="ir.ui.view">
        <field name="name">product.template.si5</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_si5_lookup" type="object" string="Look up GTIN with SI5" groups="product.group_product_manager" invisible="not barcode or product_variant_count != 1"/>
            </xpath>
        </field>
    </record>
    <record id="product_form_si5" model="ir.ui.view">
        <field name="name">product.product.si5</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_si5_lookup" type="object" string="Look up GTIN with SI5" groups="product.group_product_manager" invisible="not barcode"/>
            </xpath>
        </field>
    </record>
    <record id="lookup_consent_form" model="ir.ui.view">
        <field name="name">si5.lookup.consent.form</field>
        <field name="model">si5.lookup.consent</field>
        <field name="arch" type="xml">
            <!-- Nothing is sent before "Look up" with the box ticked; Cancel/close stays in the browser. -->
            <form string="Look up GTIN with SI5 Global">
                <group>
                    <field name="product_id"/>
                    <field name="code"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </group>
                <div name="data_sent">
                    <p class="fw-bold mb-1">What will be sent</p>
                    <ul>
                        <li>One HTTPS request from the Odoo server to <b>global.si5.com.br</b> with this <b>barcode</b>, the company <b>API token</b> and a User-Agent naming this module.</li>
                        <li>No other Odoo data: not the product name, prices, stock, customers, partners, invoices or users.</li>
                        <li>If the review shows a picture, it is downloaded from the SI5 picture server only when you click <i>Download and preview</i>, without the token.</li>
                        <li>SI5 Global receives the request itself (barcode, time and the server IP address) to count the plan quota. Privacy policy: <a href="https://global.si5.com.br/privacidade" target="_blank">global.si5.com.br/privacidade</a>.</li>
                    </ul>
                    <p class="text-muted mb-3">The lookup only shows suggestions: nothing is written to the product until you review and apply them.</p>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <field name="consent" nolabel="1"/>
                    <label for="consent" class="mb-0"/>
                </div>
                <footer>
                    <button name="action_lookup" type="object" string="Look up" class="btn-primary" invisible="not consent"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="lookup_form" model="ir.ui.view">
        <field name="name">si5.lookup.form</field>
        <field name="model">si5.lookup</field>
        <field name="arch" type="xml">
            <!-- Standard form markup only (Bootstrap grid already used by Odoo core); no custom JS/CSS. -->
            <form string="Review SI5 suggestions">
                <div class="alert alert-info mb-3" role="alert">Source: SI5 Global. No fields are selected by default. Coverage is not guaranteed; fiscal references require accountant review.</div>
                <group col="4" class="mb-0">
                    <field name="product_id"/>
                    <field name="code"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="state" invisible="1"/>
                </group>

                <!-- one row per field: current | suggested | replace -->
                <div class="row fw-bold text-muted small text-uppercase border-bottom pb-1 mb-2 mt-2">
                    <div class="col-2"/>
                    <div class="col-4">Current</div>
                    <div class="col-4">Suggested</div>
                    <div class="col-2 text-center">Replace</div>
                </div>
                <div class="row align-items-center mb-2" name="row_name">
                    <div class="col-2"><span class="fw-bold">Name</span></div>
                    <div class="col-4"><field name="current_name" nolabel="1"/></div>
                    <div class="col-4"><field name="proposed_name" nolabel="1" class="w-100"/></div>
                    <div class="col-2 text-center"><field name="apply_name" nolabel="1" widget="boolean_toggle"/></div>
                </div>
                <div class="row align-items-center mb-2" name="row_description">
                    <div class="col-2"><span class="fw-bold">Internal note</span></div>
                    <div class="col-4 text-muted"><field name="current_description" nolabel="1"/></div>
                    <div class="col-4"><field name="proposed_description" nolabel="1" class="w-100"/></div>
                    <div class="col-2 text-center"><field name="apply_description" nolabel="1" widget="boolean_toggle"/></div>
                </div>
                <div class="row align-items-center mb-2" name="row_weight">
                    <div class="col-2"><span class="fw-bold">Weight</span></div>
                    <div class="col-4"><div class="o_row"><field name="current_weight" nolabel="1"/><field name="weight_uom_name" nolabel="1"/></div></div>
                    <div class="col-4"><div class="o_row" invisible="not proposed_weight"><field name="proposed_weight" nolabel="1"/><field name="weight_uom_name" nolabel="1"/></div><span class="text-muted" invisible="proposed_weight">No suggestion</span></div>
                    <div class="col-2 text-center"><field name="apply_weight" nolabel="1" widget="boolean_toggle" invisible="not proposed_weight"/></div>
                </div>
                <div class="row align-items-center mb-2" name="row_image">
                    <div class="col-2"><span class="fw-bold">Picture</span></div>
                    <div class="col-4"><field name="current_image" nolabel="1" widget="image" options="{'size': [96, 96]}"/></div>
                    <div class="col-4">
                        <field name="preview_image" nolabel="1" widget="image" options="{'size': [160, 160]}" invisible="not preview_image"/>
                        <button name="action_preview_image" type="object" string="Download and preview" icon="fa-download" class="btn-secondary" invisible="state != 'draft' or not image_url or preview_image"/>
                        <span class="text-muted" invisible="image_url">No picture</span>
                        <field name="image_url" nolabel="1" groups="base.group_no_one" class="small text-muted d-block"/>
                    </div>
                    <div class="col-2 text-center"><field name="apply_image" nolabel="1" widget="boolean_toggle" invisible="not preview_image"/></div>
                </div>
                <div class="row align-items-center mb-2 pt-2 border-top" name="row_fiscal">
                    <div class="col-2"><span class="fw-bold">Fiscal reference</span></div>
                    <div class="col-10 text-muted"><field name="fiscal_reference" nolabel="1"/></div>
                </div>

                <div class="alert alert-warning d-flex align-items-center gap-2 mt-3 mb-0" role="alert" name="confirm_shared_box" invisible="not (apply_name or apply_description or apply_image)">
                    <field name="confirm_shared" nolabel="1" widget="boolean_toggle"/>
                    <label for="confirm_shared" class="mb-0"/>
                </div>
                <footer>
                    <button name="action_apply" type="object" string="Apply selected fields" class="btn-primary" invisible="state != 'draft'"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="res_config_settings_view_form_si5" model="ir.ui.view">
        <field name="name">res.config.settings.si5</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='general_settings']" position="inside">
                <block title="SI5 Global" name="si5_global_setting_container" groups="base.group_system">
                    <setting id="si5_global_token" string="GTIN lookup token" help="API token created at global.si5.com.br/conta for the current company. The SI5_TOKEN_COMPANY_&lt;id&gt; server environment variable, when set, takes precedence.">
                        <field name="si5_token" password="True" placeholder="Paste the token"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
